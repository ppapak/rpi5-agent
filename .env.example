# ============================================================
# Native-AI configuration.
#
# scripts/install.sh copies this to $BASE_DIR/.env and stamps in the values it
# knows (BASE_DIR plus everything under "Board runtime"). Edit the deployed copy
# and restart: sudo systemctl restart voice-assistant
#
# Full reference: docs/configuration.md
# ============================================================

# --- Identity ---
# Also the wake word, lowercased. Pick something Vosk hears reliably.
AGENT_NAME=Agent

# Install directory. Set by the installer; defaults to ~/native-ai.
BASE_DIR=

# --- Board runtime (set from profiles/<board>.conf at install time) ---
# Mic capture rate. Must match what the sound card actually provides.
SAMPLE_RATE=48000
# Mic buffer size. Raise it if the journal shows input overruns.
FRAMES_PER_BUFFER=2048
# Chat format for the loaded model: gemma or chatml.
PROMPT_FORMAT=gemma

# Retrieval over workspace/ via ChromaDB. Needs ~1 GB of headroom.
FEATURE_RAG=1
# Camera object detection. Requires picamera2 and opencv.
FEATURE_VISION=0
# INA219 battery telemetry over I2C.
FEATURE_BATTERY=0
# [WRITE:] / [EMAIL:] tool calls. See docs/tools.md.
FEATURE_TOOLS=0

# --- Inference server ---
LLAMA_API_URL=http://localhost:8080/completion
HEALTH_URL=http://localhost:8080/health
# Response length cap, in tokens.
N_PREDICT=128

# --- Asset paths (relative to BASE_DIR) ---
VOSK_MODEL_NAME=vosk-model-small-en-us-0.15
PIPER_BIN_PATH=piper/piper/piper
PIPER_MODEL_NAME=piper/en_US-lessac-medium.onnx
EMBEDDING_MODEL_NAME_OR_PATH=all-MiniLM-L6-v2

# --- Memory tuning ---
# Max vector distance for a workspace chunk to count as relevant. Lower is stricter.
DIST_THRESHOLD=0.7
# How many past turns to replay into the prompt.
PAST_DISCUSSIONS=3

# --- Vision tuning ---
# Minimum detection confidence before an object is spoken.
VISION_CONFIDENCE=0.30

# --- Tools: email (only used when FEATURE_TOOLS=1) ---
# Use an app-specific password, never your account password.
SMTP_SERVER=
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
RECEIVER_EMAIL=
